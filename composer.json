{
    "name": "ama/maritime-agency-web",
    "description": "Plataforma web corporativa, portal interno con Microsoft Entra ID (OIDC/PKCE + App Roles RBAC) y bot de correo Microsoft Graph para agencia marítima",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "AMA\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "check": "php -l api-bridge/bridge.php",
        "test": [
            "@php tests/test_tc_mailbot.php",
            "@php tests/test_entra_oidc.php",
            "@php tests/test_entra_roles.php",
            "@php tests/test_entra_state.php",
            "@php tests/test_entra_ui.php"
        ]
    }
}
